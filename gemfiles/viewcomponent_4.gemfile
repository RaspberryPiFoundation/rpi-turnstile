# This file was generated by Appraisal

source "https://rubygems.org"

gem "importmap-rails"
gem "puma", ">= 6.4"
gem "sprockets-rails"
gem "stimulus-rails"
gem "turbo-rails"
gem "rails", "~> 8.1"
gem "view_component", "~> 4.12"

group :development do
  gem "debug"
  gem "openssl", "~> 3.0"
  gem "rubocop"
  gem "rubocop-performance"
  gem "rubocop-rails"
  gem "rubocop-rspec"
end

group :test, :development do
  gem "appraisal"
  gem "dotenv-rails", require: "dotenv/rails-now"
end

group :test do
  gem "capybara"
  gem "climate_control"
  gem "rspec"
  gem "rspec_junit_formatter"
  gem "rspec-rails"
  gem "selenium-webdriver"
  gem "simplecov", require: false
  gem "webmock"
end

gemspec path: "../"
